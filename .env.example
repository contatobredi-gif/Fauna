# Este frontend não exige chaves de API para rodar localmente.
# Copie este arquivo para .env apenas se precisar de variáveis futuras.

# URL pública do site (opcional). Útil em deploys.
# APP_URL=http://localhost:3000

# Homologação: configurar SOMENTE em Preview, branch homologacao, na Vercel.
# Para testar localmente, definir a variável no processo de build/dev.
# VITE_APP_ENV=homologacao
# Não configurar essa variável em Production.
# Na Vercel, o build ignora a sinalização fora de Preview/homologacao.

# Origem HTTPS oficial, quando aprovada para produção (sem rota).
# VITE_PUBLIC_SITE_URL=
